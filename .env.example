# ── LLM Providers ──────────────────────────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...

# ── LangSmith ──────────────────────────────────────────────
LANGCHAIN_API_KEY=ls__...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=self-healing-rag

# ── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ragdb
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ragdb

# ── Redis ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ────────────────────────────────────────────────────
APP_ENV=development
APP_API_KEY=your-secret-api-key-here
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ── RAG Config ─────────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
CRITIC_PASS_THRESHOLD=0.70
MAX_RETRY_COUNT=3
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ── LLM Routing ────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini
CRITIC_LLM_PROVIDER=groq
CRITIC_LLM_MODEL=llama3-8b-8192